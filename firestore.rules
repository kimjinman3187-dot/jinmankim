    function businessHistoryCreateValid(documentId, historyId) {
      let h = request.resource.data;
      let dp = /databases/$(database)/documents/business_documents/$(documentId);
      let after = getAfter(dp).data;
      return businessActive() && h.keys().hasOnly(["operationId", "action", "actorUid", "actorName", "actorRole", "at", "reason", "previousStatus", "nextStatus"])
        && h.operationId == historyId && h.operationId == after.lastOperationId
        && h.action in ["create", "updateDraft", "submit", "approve", "reject", "withdraw", "cancelApproved", "complete", "settle", "pay"]
        && h.actorUid == request.auth.uid && h.actorName == arUserDoc().get("name", "") && h.actorRole == arUserDoc().get("role", "")
        && h.at == request.time && h.reason is string && h.reason.size() <= 500
        && h.nextStatus == after.status
        && ((h.action == "create" && !exists(dp) && h.previousStatus == "none" && h.nextStatus == "draft")
          || (h.action != "create" && exists(dp) && h.previousStatus == get(dp).data.status));
    }
    function businessChunkIdValid(chunkId, slot, index) {
      return (index == 0 && chunkId == slot + "-0")
        || (index == 1 && chunkId == slot + "-1")
        || (index == 2 && chunkId == slot + "-2")
        || (index == 3 && chunkId == slot + "-3")
        || (index == 4 && chunkId == slot + "-4")
        || (index == 5 && chunkId == slot + "-5");
    }
    function businessChunkCreateValid(documentId, chunkId) {
      let parent = get(/databases/$(database)/documents/business_documents/$(documentId)).data;
      let chunk = request.resource.data;
      let empty = {"name": "", "size": 0, "contentType": "", "chunkCount": 0, "sha256": "", "firestorePath": ""};
      let attachment = parent.attachments.get(chunk.slot, empty);
      return businessActive() && parent.schemaVersion in [6, 7, 8] && parent.clientMode == "spark-firestore"
        && parent.status == "draft" && parent.requesterUid == request.auth.uid
        && chunk.keys().hasOnly(["slot", "index", "size", "sha256", "data", "uploaderUid", "uploadedAt"])
        && chunk.slot in ["a0", "a1", "a2", "a3", "a4"]
        && chunk.index is int && chunk.index >= 0 && chunk.index < attachment.chunkCount
        && businessChunkIdValid(chunkId, chunk.slot, chunk.index)
        && chunk.size is int && chunk.size >= 1 && chunk.size <= 524288
        && chunk.data is bytes && chunk.data.size() == chunk.size
        && ((chunk.index < attachment.chunkCount - 1 && chunk.size == 524288)
          || (chunk.index == attachment.chunkCount - 1 && chunk.size == attachment.size - (attachment.chunkCount - 1) * 524288))
        && chunk.sha256 == attachment.sha256 && chunk.uploaderUid == request.auth.uid
        && chunk.uploadedAt == request.time;
    }
    function businessChunkExists(documentId, slot, index) {
      return (index == 0 && exists(/databases/$(database)/documents/business_documents/$(documentId)/attachment_chunks/$(slot + "-0")))
        || (index == 1 && exists(/databases/$(database)/documents/business_documents/$(documentId)/attachment_chunks/$(slot + "-1")))
        || (index == 2 && exists(/databases/$(database)/documents/business_documents/$(documentId)/attachment_chunks/$(slot + "-2")))
        || (index == 3 && exists(/databases/$(database)/documents/business_documents/$(documentId)/attachment_chunks/$(slot + "-3")))
        || (index == 4 && exists(/databases/$(database)/documents/business_documents/$(documentId)/attachment_chunks/$(slot + "-4")))
        || (index == 5 && exists(/databases/$(database)/documents/business_documents/$(documentId)/attachment_chunks/$(slot + "-5")));
    }
    function businessManifestCreateValid(documentId, slot) {
      let parent = get(/databases/$(database)/documents/business_documents/$(documentId)).data;
      let manifest = request.resource.data;
      let empty = {"name": "", "size": 0, "contentType": "", "chunkCount": 0, "sha256": "", "firestorePath": ""};
      let attachment = parent.attachments.get(slot, empty);
      return businessActive() && parent.schemaVersion in [6, 7, 8] && parent.clientMode == "spark-firestore"
        && parent.status == "draft" && parent.requesterUid == request.auth.uid
        && slot in ["a0", "a1", "a2", "a3", "a4"]
        && manifest.keys().hasOnly(["name", "size", "contentType", "chunkCount", "sha256", "firestorePath", "uploaderUid", "completedAt"])
        && manifest.name == attachment.name && manifest.size == attachment.size
        && manifest.contentType == attachment.contentType && manifest.chunkCount == attachment.chunkCount
        && manifest.sha256 == attachment.sha256 && manifest.firestorePath == attachment.firestorePath
        && manifest.uploaderUid == request.auth.uid && manifest.completedAt == request.time
        && businessChunkExists(documentId, slot, 0)
        && (attachment.chunkCount < 2 || businessChunkExists(documentId, slot, 1))
        && (attachment.chunkCount < 3 || businessChunkExists(documentId, slot, 2))
        && (attachment.chunkCount < 4 || businessChunkExists(documentId, slot, 3))
        && (attachment.chunkCount < 5 || businessChunkExists(documentId, slot, 4))
        && (attachment.chunkCount < 6 || businessChunkExists(documentId, slot, 5));
    }
    match /business_approver_directory/{uid} {
      allow read: if businessActive();
      allow create, update: if arIsAdmin()
        && request.resource.data.keys().hasOnly(["name", "role", "status"])
        && request.resource.data.name == businessUser(uid).get("name", "")
        && request.resource.data.role == businessUser(uid).get("role", "")
        && request.resource.data.role in ["admin", "accounting"]
        && request.resource.data.status == businessUser(uid).get("status", "");
      allow delete: if false;
    }
    match /business_documents/{documentId} {
      allow get, list: if businessCanRead(resource.data);
      allow create: if businessDocumentCreateValid(documentId);
      allow update: if businessDocumentUpdateValid(documentId);
      allow delete: if false;
      match /history/{historyId} {
        allow read: if businessCanRead(get(/databases/$(database)/documents/business_documents/$(documentId)).data);
        allow create: if businessHistoryCreateValid(documentId, historyId);
        allow update, delete: if false;
      }
      match /attachment_chunks/{chunkId} {
        allow read: if businessCanRead(get(/databases/$(database)/documents/business_documents/$(documentId)).data);
        allow create: if businessChunkCreateValid(documentId, chunkId);
        allow update: if false;
        allow delete: if businessActive()
          && get(/databases/$(database)/documents/business_documents/$(documentId)).data.status == "draft"
          && get(/databases/$(database)/documents/business_documents/$(documentId)).data.requesterUid == request.auth.uid;
      }
      match /attachment_uploads/{slot} {
        allow read: if businessCanRead(get(/databases/$(database)/documents/business_documents/$(documentId)).data);
        allow create: if businessManifestCreateValid(documentId, slot);
        allow update: if false;
        allow delete: if businessActive()
          && get(/databases/$(database)/documents/business_documents/$(documentId)).data.status == "draft"
          && get(/databases/$(database)/documents/business_documents/$(documentId)).data.requesterUid == request.auth.uid;
      }
      match /payments/{paymentId} {
        allow read: if businessCanRead(get(/databases/$(database)/documents/business_documents/$(documentId)).data);
        allow create: if businessPaymentDraftCreateValid(documentId, paymentId);
        allow update: if businessPaymentUpdateValid(documentId, paymentId);
        allow delete: if false;
        match /proof_chunks/{chunkId} {
          allow read: if businessCanRead(get(/databases/$(database)/documents/business_documents/$(documentId)).data);
          allow create: if businessPaymentChunkCreateValid(documentId, paymentId, chunkId);
          allow update, delete: if false;
        }
        match /proof_upload/{manifestId} {
          allow read: if businessCanRead(get(/databases/$(database)/documents/business_documents/$(documentId)).data);
          allow create: if businessPaymentManifestCreateValid(documentId, paymentId, manifestId);
          allow update, delete: if false;
        }
      }
    }
    match /business_document_sequences/{id} { allow read, write: if false; }
    match /business_payment_references/{reference} {
      allow read: if businessFinance();
      allow create: if businessFinance()
        && request.resource.data.keys().hasOnly(["documentId", "paymentId", "reference", "actorUid", "createdAt"])
        && request.resource.data.reference == reference && reference.matches("^[A-Z0-9._-]{1,64}$")
        && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(businessPaymentPath(request.resource.data.documentId, request.resource.data.paymentId)).data.status == "recorded";
      allow update, delete: if false;
    }
    match /business_document_notifications/{notificationId} {
      allow read: if businessActive() && resource.data.recipientUid == request.auth.uid;
      allow create: if businessNotificationCreateValid(notificationId);
      allow update: if businessActive() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
        && resource.data.readAt == null && request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    match /expense_approval_requests/{requestId} {
      allow read: if arIsAdmin() || isExpenseApprovalOwner() || arIsAccounting();
      allow create: if arIsActiveUser()
        && request.resource.data.get("schemaVersion", 0) == 3
        && request.resource.data.get("formType", "") == "expense"
        && hasValidExpenseCreateShape(requestId);
      allow update: if false;
      allow delete: if isExpenseApprovalOwner()
        && resource.data.status == "draft";

      match /history/{historyId} {
        allow read: if arIsAdmin() || isExpenseApprovalHistoryOwner(requestId);
        allow write: if false;
      }

      match /workflow/state {
        allow read: if arIsAdmin() || isExpenseApprovalOwner() || arIsAccounting();
        allow write: if false;
      }
    }
  }
}
