rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function arIsGoogleUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email != ""
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function arUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function arIsActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && arUserDoc().get("status", "") == "active";
    }

    function arIsAdmin() {
      return arIsActiveUser() && arUserDoc().get("role", "") == "admin";
    }

    function validAssignableRole(role) {
      return role in ["admin", "sales", "accounting", "factory"];
    }

    function validUserStatus(status) {
      return status in ["active", "inactive"];
    }

    function userWriteKeys() {
      return [
        "id", "uid", "email", "emailLower", "displayName", "name",
        "provider", "auth_uid", "role", "status", "account_type",
        "legacyUserId", "device_id", "pin", "sort_index", "attempts",
        "lockoutUntil", "permissions", "created_at", "createdAt",
        "createdAtKst", "updated_at", "updatedAt", "updatedAtKst"
      ];
    }

    function hasValidUserWriteShape(targetUid) {
      return request.resource.data.keys().hasOnly(userWriteKeys())
        && validAssignableRole(request.resource.data.role)
        && validUserStatus(request.resource.data.status)
        && request.resource.data.email is string
        && request.resource.data.emailLower is string
        && request.resource.data.provider in ["google", "pin", "legacy"]
        && request.resource.data.auth_uid == targetUid;
    }

    function preventsAdminSelfLockout(targetUid) {
      return targetUid != request.auth.uid
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "status"]);
    }

    function isUserLockStateUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["attempts", "lockoutUntil"]);
    }

    function hasValidAssignedRole() {
      return !request.resource.data.keys().hasAny(["assigned_role"])
        || validAssignableRole(request.resource.data.assigned_role);
    }

    function validDocumentApprovalStatus(status) {
      return status in ["draft", "pending", "approved", "rejected", "on_hold", "applied", "cancelled"];
    }

    function validDocumentApprovalRequestType(requestType) {
      return requestType in ["document", "test_document"];
    }

    function documentApprovalRequestKeys() {
      return [
        "requestId", "requestType", "title", "documentType", "description",
        "payload", "requesterUid", "requesterName", "requesterEmail",
        "requesterRole", "requesterSite", "status", "createdAt",
        "submittedAt", "updatedAt", "reviewerUid", "reviewerName",
        "reviewedAt", "reviewComment", "rejectionReason", "holdReason",
        "approvedAt", "appliedAt", "appliedByUid", "lastTransitionId",
        "schemaVersion", "isTest",
        "attachments", "attachmentCount", "attachmentsTotalSize"
      ];
    }

    function documentApprovalImmutableKeys() {
      return [
        "requestId", "requestType", "title", "documentType", "description",
        "payload", "requesterUid", "requesterName", "requesterEmail",
        "requesterRole", "requesterSite", "createdAt", "schemaVersion", "isTest"
      ];
    }

    function documentApprovalAdminUpdateKeys() {
      return [
        "status", "updatedAt", "reviewerUid", "reviewerName",
        "reviewedAt", "reviewComment", "rejectionReason",
        "holdReason", "approvedAt", "lastTransitionId"
      ];
    }

    // WORK29: 문서결재 첨부파일 (schemaVersion 2) 검증.
    // NOTE: contentType allow-list(확장자↔MIME) 강제는 실제 업로드 경계인 storage.rules
    // 에서 수행한다. Firestore 규칙은 1000-expression 한도 때문에 첨부 항목당 구조/경로/
    // 크기만 검증하고 contentType 은 문자열 존재만 확인한다.
    function attachmentEntryKeys() {
      return ["slot", "name", "storagePath", "contentType", "size"];
    }

    function attachmentEntryValid(entry, expectedSlot, requesterUid, requestId) {
      // keys().hasOnly + 아래 필드 접근/타입 검사로 5개 키의 존재·형식을 모두 강제.
      return entry is map
        && entry.keys().hasOnly(attachmentEntryKeys())
        && entry.slot == expectedSlot
        && entry.name is string
        && entry.name.size() <= 255
        && entry.contentType is string
        && entry.size is int
        && entry.size >= 1
        && entry.size <= 10485760
        && entry.storagePath == "document-approval-attachments/" + requesterUid + "/" + requestId + "/" + expectedSlot;
    }

    function attachmentsMapValid(attachments, requesterUid, requestId) {
      return attachments is map
        && attachments.keys().hasOnly(["a0", "a1", "a2", "a3", "a4"])
        && attachments.keys().size() >= 1
        && attachments.keys().size() <= 5
        && (!("a0" in attachments) || attachmentEntryValid(attachments.a0, "a0", requesterUid, requestId))
        && (!("a1" in attachments) || attachmentEntryValid(attachments.a1, "a1", requesterUid, requestId))
        && (!("a2" in attachments) || attachmentEntryValid(attachments.a2, "a2", requesterUid, requestId))
        && (!("a3" in attachments) || attachmentEntryValid(attachments.a3, "a3", requesterUid, requestId))
        && (!("a4" in attachments) || attachmentEntryValid(attachments.a4, "a4", requesterUid, requestId));
    }

    function hasValidDocumentApprovalAttachments(requestId) {
      return request.resource.data.attachments is map
        && request.resource.data.attachmentCount is int
        && request.resource.data.attachmentCount >= 1
        && request.resource.data.attachmentCount <= 5
        && request.resource.data.attachments.keys().size() == request.resource.data.attachmentCount
        && request.resource.data.attachmentsTotalSize is int
        && request.resource.data.attachmentsTotalSize >= 1
        && request.resource.data.attachmentsTotalSize <= 31457280
        && attachmentsMapValid(request.resource.data.attachments, request.auth.uid, requestId);
    }

    // WORK29: v1(첨부 없음·pending)과 v2(첨부 있음·draft) 생성을 하나의 allow 로 검증.
    // 두 create shape 를 각각 별도 allow 로 두면 공통 base 가 중복 인라인되어
    // Firestore 1000-expression 한도를 초과한다. 공통 base 를 한 번만 인라인하고
    // schemaVersion 으로 분기해 한도 내에서 두 경로를 모두 검증한다.
    function hasValidDocumentApprovalUnifiedCreateShape(requestId) {
      return request.resource.data.keys().hasOnly(documentApprovalRequestKeys())
        && request.resource.data.requestType == "document"
        && request.resource.data.documentType == "GENERAL_APPROVAL"
        && !request.resource.data.keys().hasAny([
          "requestId", "requesterEmail", "requesterSite", "isTest"
        ])
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().hasOnly(["kind", "body"])
        && request.resource.data.payload.keys().hasAll(["kind", "body"])
        && request.resource.data.payload.get("kind", "") == "general_approval"
        && request.resource.data.payload.body is map
        && request.resource.data.payload.body.keys().hasOnly([])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 2
        && request.resource.data.description.size() <= 1000
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName != ""
        && request.resource.data.requesterName == arUserDoc().get("name", "")
        && request.resource.data.requesterRole == arUserDoc().get("role", "")
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewerUid == null
        && request.resource.data.reviewerName == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewComment == null
        && request.resource.data.rejectionReason == null
        && request.resource.data.holdReason == null
        && request.resource.data.approvedAt == null
        && request.resource.data.appliedAt == null
        && request.resource.data.appliedByUid == null
        && request.resource.data.lastTransitionId == null
        && (
          (
            request.resource.data.schemaVersion == 1
            && request.resource.data.status == "pending"
            && request.resource.data.submittedAt == request.time
            && !request.resource.data.keys().hasAny([
              "attachments", "attachmentCount", "attachmentsTotalSize"
            ])
          ) || (
            request.resource.data.schemaVersion == 2
            && request.resource.data.status == "draft"
            && request.resource.data.submittedAt == null
            && hasValidDocumentApprovalAttachments(requestId)
          )
        );
    }

    function isDocumentApprovalOwner() {
      return arIsActiveUser()
        && resource.data.requesterUid == request.auth.uid;
    }

    function isDocumentApprovalHistoryOwner(requestId) {
      return arIsActiveUser()
        && get(/databases/$(database)/documents/document_approval_requests/$(requestId)).data.requesterUid == request.auth.uid;
    }

    function documentApprovalUserTransitionAllowed() {
      return documentApprovalUserTransitionAllowedFrom(
        resource.data.status,
        request.resource.data.status
      );
    }

    function documentApprovalUserTransitionAllowedFrom(previousStatus, nextStatus) {
      return (
        previousStatus == "draft"
          && nextStatus in ["draft", "pending", "cancelled"]
      ) || (
        previousStatus == "pending"
          && nextStatus == "cancelled"
      ) || (
        previousStatus == "on_hold"
          && nextStatus == "pending"
      );
    }

    function validDocumentApprovalTransitionId(transitionId) {
      return transitionId is string
        && transitionId.size() >= 16
        && transitionId.size() <= 128;
    }

    function documentApprovalHistoryPath(requestId, transitionId) {
      return /databases/$(database)/documents/document_approval_requests/$(requestId)/history/$(transitionId);
    }

    function validDocumentApprovalHistoryAction(previousStatus, nextStatus, action) {
      return (
        previousStatus == "draft" && nextStatus == "pending" && action == "submitted"
      ) || (
        previousStatus == "draft" && nextStatus == "cancelled" && action == "cancelled"
      ) || (
        previousStatus == "pending" && nextStatus == "cancelled" && action == "cancelled"
      ) || (
        previousStatus == "pending" && nextStatus == "approved" && action == "approved"
      ) || (
        previousStatus == "pending" && nextStatus == "rejected" && action == "rejected"
      ) || (
        previousStatus == "pending" && nextStatus == "on_hold" && action == "on_hold"
      ) || (
        previousStatus == "on_hold" && nextStatus == "pending" && action == "resumed"
      ) || (
        previousStatus == "on_hold" && nextStatus == "approved" && action == "approved"
      ) || (
        previousStatus == "on_hold" && nextStatus == "rejected" && action == "rejected"
      );
    }

    function hasMatchingDocumentApprovalHistoryAfter(requestId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastTransitionId"])
        && validDocumentApprovalTransitionId(request.resource.data.get("lastTransitionId", ""))
        && request.resource.data.get("lastTransitionId", null) != resource.data.get("lastTransitionId", null)
        && !exists(documentApprovalHistoryPath(requestId, request.resource.data.lastTransitionId))
        && existsAfter(documentApprovalHistoryPath(requestId, request.resource.data.lastTransitionId))
        && getAfter(documentApprovalHistoryPath(requestId, request.resource.data.lastTransitionId)).data.requestId == requestId
        && getAfter(documentApprovalHistoryPath(requestId, request.resource.data.lastTransitionId)).data.transitionId == request.resource.data.lastTransitionId
        && getAfter(documentApprovalHistoryPath(requestId, request.resource.data.lastTransitionId)).data.previousStatus == resource.data.status
        && getAfter(documentApprovalHistoryPath(requestId, request.resource.data.lastTransitionId)).data.nextStatus == request.resource.data.status
        && getAfter(documentApprovalHistoryPath(requestId, request.resource.data.lastTransitionId)).data.actorUid == request.auth.uid
        && validDocumentApprovalHistoryAction(
          resource.data.status,
          request.resource.data.status,
          getAfter(documentApprovalHistoryPath(requestId, request.resource.data.lastTransitionId)).data.action
        );
    }

    function hasValidDocumentApprovalTransitionHistoryState(requestId) {
      return (
        request.resource.data.status == resource.data.status
          && request.resource.data.get("lastTransitionId", null) == resource.data.get("lastTransitionId", null)
      ) || (
        request.resource.data.status != resource.data.status
          && hasMatchingDocumentApprovalHistoryAfter(requestId)
      );
    }

    function hasValidDocumentApprovalUserUpdateShape(requestId) {
      return isDocumentApprovalOwner()
        && request.resource.data.keys().hasOnly(documentApprovalRequestKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title", "documentType", "description", "payload", "status",
          "submittedAt", "updatedAt", "lastTransitionId"
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["updatedAt"])
        && request.resource.data.diff(resource.data).unchangedKeys().hasAll([
          "requesterUid", "requesterName", "requesterRole", "createdAt", "schemaVersion"
        ])
        && validDocumentApprovalStatus(request.resource.data.status)
        && documentApprovalUserTransitionAllowed()
        && hasValidDocumentApprovalTransitionHistoryState(requestId)
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["submittedAt"])
          || request.resource.data.submittedAt == request.time
        )
        && request.resource.data.get("reviewerUid", null) == resource.data.get("reviewerUid", null)
        && request.resource.data.get("reviewerName", null) == resource.data.get("reviewerName", null)
        && request.resource.data.get("reviewedAt", null) == resource.data.get("reviewedAt", null)
        && request.resource.data.get("reviewComment", null) == resource.data.get("reviewComment", null)
        && request.resource.data.get("rejectionReason", null) == resource.data.get("rejectionReason", null)
        && request.resource.data.get("holdReason", null) == resource.data.get("holdReason", null)
        && request.resource.data.get("approvedAt", null) == resource.data.get("approvedAt", null)
        && request.resource.data.get("appliedAt", null) == resource.data.get("appliedAt", null)
        && request.resource.data.get("appliedByUid", null) == resource.data.get("appliedByUid", null);
      // 첨부(attachments/attachmentCount/attachmentsTotalSize) 는 affectedKeys().hasOnly()
      // 허용 목록에 없으므로 이 update 경로에서 변경 시 자동 차단됨 (불변 보장).
    }

    function documentApprovalAdminTransitionAllowed() {
      return documentApprovalAdminTransitionAllowedFrom(
        resource.data.status,
        request.resource.data.status
      );
    }

    function documentApprovalAdminTransitionAllowedFrom(previousStatus, nextStatus) {
      return (
        previousStatus == "pending"
          && nextStatus in ["approved", "rejected", "on_hold"]
      ) || (
        previousStatus == "on_hold"
          && nextStatus in ["pending", "approved", "rejected"]
      );
    }

    function isValidDocumentApprovalReason(reason) {
      return reason is string
        && reason.size() >= 2
        && reason.size() <= 500;
    }

    function hasValidDocumentApprovalAdminUpdateShape(requestId) {
      return arIsAdmin()
        && request.resource.data.keys().hasOnly(documentApprovalRequestKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(documentApprovalAdminUpdateKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "status", "updatedAt", "reviewerUid", "reviewerName", "reviewedAt"
        ])
        && request.resource.data.requestType == resource.data.requestType
        && request.resource.data.title == resource.data.title
        && request.resource.data.payload == resource.data.payload
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.requesterName == resource.data.requesterName
        && request.resource.data.requesterRole == resource.data.requesterRole
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.get("requestId", null) == resource.data.get("requestId", null)
        && request.resource.data.get("documentType", null) == resource.data.get("documentType", null)
        && request.resource.data.get("description", null) == resource.data.get("description", null)
        && request.resource.data.get("requesterEmail", null) == resource.data.get("requesterEmail", null)
        && request.resource.data.get("requesterSite", null) == resource.data.get("requesterSite", null)
        && request.resource.data.get("isTest", null) == resource.data.get("isTest", null)
        && validDocumentApprovalStatus(request.resource.data.status)
        && documentApprovalAdminTransitionAllowed()
        && hasMatchingDocumentApprovalHistoryAfter(requestId)
        && request.resource.data.status != "applied"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.reviewerName == arUserDoc().get("name", "")
        && request.resource.data.reviewerName != ""
        && request.resource.data.get("appliedAt", null) == resource.data.get("appliedAt", null)
        && request.resource.data.get("appliedByUid", null) == resource.data.get("appliedByUid", null)
        && (
          request.resource.data.status != "approved"
          || request.resource.data.approvedAt == request.time
        )
        && (
          request.resource.data.status != "rejected"
          || isValidDocumentApprovalReason(request.resource.data.rejectionReason)
        )
        && (
          request.resource.data.status != "on_hold"
          || isValidDocumentApprovalReason(request.resource.data.holdReason)
        )
        && (
          request.resource.data.status != "approved"
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["rejectionReason", "holdReason"])
        );
    }

    function documentApprovalHistoryKeys() {
      return [
        "requestId", "action", "previousStatus", "nextStatus", "actorUid",
        "actorName", "actorRole", "comment", "createdAt", "schemaVersion",
        "transitionId"
      ];
    }

    function hasValidDocumentApprovalHistoryCreateShape(requestId, historyId) {
      return arIsActiveUser()
        && exists(/databases/$(database)/documents/document_approval_requests/$(requestId))
        && existsAfter(/databases/$(database)/documents/document_approval_requests/$(requestId))
        && request.resource.data.keys().hasOnly(documentApprovalHistoryKeys())
        && request.resource.data.keys().hasAll(documentApprovalHistoryKeys())
        && validDocumentApprovalTransitionId(historyId)
        && request.resource.data.transitionId == historyId
        && request.resource.data.requestId == requestId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == arUserDoc().get("role", "")
        && validDocumentApprovalStatus(request.resource.data.previousStatus)
        && validDocumentApprovalStatus(request.resource.data.nextStatus)
        && request.resource.data.previousStatus != request.resource.data.nextStatus
        && (
          (
            isDocumentApprovalHistoryOwner(requestId)
              && documentApprovalUserTransitionAllowedFrom(
                request.resource.data.previousStatus,
                request.resource.data.nextStatus
              )
          ) || (
            arIsAdmin()
              && documentApprovalAdminTransitionAllowedFrom(
                request.resource.data.previousStatus,
                request.resource.data.nextStatus
              )
          )
        )
        && request.resource.data.previousStatus == get(/databases/$(database)/documents/document_approval_requests/$(requestId)).data.status
        && request.resource.data.nextStatus == getAfter(/databases/$(database)/documents/document_approval_requests/$(requestId)).data.status
        && request.resource.data.transitionId == getAfter(/databases/$(database)/documents/document_approval_requests/$(requestId)).data.lastTransitionId
        && get(/databases/$(database)/documents/document_approval_requests/$(requestId)).data.status != getAfter(/databases/$(database)/documents/document_approval_requests/$(requestId)).data.status
        && validDocumentApprovalHistoryAction(
          request.resource.data.previousStatus,
          request.resource.data.nextStatus,
          request.resource.data.action
        )
        && request.resource.data.nextStatus != "applied"
        && request.resource.data.createdAt == request.time
        && request.resource.data.schemaVersion == 1;
    }

    // WORK25-AUTH-RULES-HARDENING-01:
    // 익명/미승인 사용자의 데이터 접근 차단.
    // users 읽기는 본인 문서(get) 또는 admin(list 포함)으로 제한해
    // 타 직원 PIN/개인정보 노출 경로를 막는다.
    match /users/{userId} {
      allow get: if isSignedIn()
        && (request.auth.uid == userId || arIsAdmin());
      allow list: if arIsAdmin();
      allow create: if arIsAdmin()
        && hasValidUserWriteShape(userId);
      allow update: if (
        arIsAdmin()
          && hasValidUserWriteShape(userId)
          && preventsAdminSelfLockout(userId)
      ) || (
        isSignedIn()
          && isUserLockStateUpdate()
          && (arIsAdmin() || request.auth.uid == userId)
      );
      allow delete: if false;
    }

    match /invite_codes/{inviteCodeId} {
      allow get, list: if arIsAdmin();
      allow create, update, delete: if false;
    }

    // 업무 데이터는 승인(active) 직원만. 삭제는 admin(Reset Data)만.
    match /orders/{orderId} {
      allow read, create, update: if arIsActiveUser();
      allow delete: if arIsAdmin();
    }

    // 감사 로그: 기록은 Google 인증(승인 전 게이트 로그 포함) 또는 active 직원,
    // 열람은 admin만. 익명 기록 불가.
    match /audit_logs/{logId} {
      allow create: if arIsGoogleUser() || arIsActiveUser();
      allow read: if arIsAdmin();
      allow update, delete: if false;
    }

    match /notifications/{notiId} {
      allow read, create, update: if arIsActiveUser();
      allow delete: if false;
    }

    match /surveys/{surveyId} {
      allow create: if arIsActiveUser();
      allow read, update, delete: if false;
    }

    match /approval_requests/{requestUid} {
      allow create: if arIsGoogleUser()
        && requestUid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.source == "google_approval_gate"
        && request.resource.data.requested_role in ["sales", "accounting", "factory"]
        && request.resource.data.reviewed_by == null
        && request.resource.data.reviewed_at == null
        && request.resource.data.decision_reason == null
        && request.resource.data.memo == null
        && !arIsActiveUser();

      allow read: if arIsAdmin()
        || (request.auth != null && requestUid == request.auth.uid);

      allow update: if arIsAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "memo", "reviewed_by", "reviewed_at", "decision_reason", "updated_at", "assigned_role"
        ])
        && hasValidAssignedRole();

      allow delete: if arIsAdmin();
    }

    match /document_approval_requests/{requestId} {
      allow read: if arIsAdmin() || isDocumentApprovalOwner();
      // create: v1/v2 를 하나의 unified shape 로 검증 (공통 base 중복 인라인 방지).
      allow create: if arIsActiveUser()
        && hasValidDocumentApprovalUnifiedCreateShape(requestId);
      // update: user/admin shape 를 한 allow 에서 OR 로 묶으면 인라인 식 트리가
      // 1000-expression 한도를 초과하므로 별도 allow 문으로 분리한다.
      // 각 문에 resource != null 가드를 둬서 create(set) 평가 시 update shape 가
      // 깊이 평가돼 한도를 건드리는 것도 막는다.
      allow update: if resource != null
        && hasValidDocumentApprovalUserUpdateShape(requestId);
      allow update: if resource != null
        && hasValidDocumentApprovalAdminUpdateShape(requestId);
      // 요청자 본인의 미제출 draft 만 삭제 허용 (업로드 실패 rollback).
      // pending 이후 및 타인 요청 삭제는 불가.
      allow delete: if isDocumentApprovalOwner()
        && resource.data.status == "draft";

      match /history/{historyId} {
        allow read: if arIsAdmin() || isDocumentApprovalHistoryOwner(requestId);
        allow create: if hasValidDocumentApprovalHistoryCreateShape(requestId, historyId);
        allow update, delete: if false;
      }
    }
  }
}
